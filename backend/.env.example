# Локальный backend и PostgreSQL из Docker Compose (порт 5436).
# Для backend в Compose: POSTGRES_HOST=db, POSTGRES_PORT=5432,
# QDRANT_URL=http://qdrant:6333. POSTGRES_DB и POSTGRES_NAME должны совпадать.
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_NAME=project_dashboard
POSTGRES_DB=project_dashboard
POOL_SIZE=5
POOL_MAX_OVERFLOW=10
POOL_TIMEOUT=5
POOL_PRE_PING=true
POOL_RECYCLE=1800

# Приложение; относительные пути считаются от рабочего каталога backend.
APP_NAME="Project Task Tracker"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
MCP_ALLOWED_ORIGINS=[]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOGGING_CONFIG_PATH=logging.ini
UPLOADS_PATH=uploads

# Замените секрет подписи и код регистрации своими значениями.
JWT_SECRET=replace-with-your-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_HOURS=336
REGISTRATION_INVITE_CODE=replace-with-your-invite-code
API_TOKEN_DEFAULT_TTL_DAYS=90
API_TOKEN_MAX_ACTIVE=10
SESSION_COOKIE_NAME=tracker_session
SESSION_COOKIE_SECURE=false
AVATARS_PATH=uploads/avatars

HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=5

# Полные URL endpoints и ключи настроенного OpenAI-совместимого провайдера.
# Идентификаторы моделей должны поддерживаться этим провайдером.
LLM_API_KEY=replace-with-your-key
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=google/gemini-3.7-flash
AGENT_MODEL=google/gemini-3.7-flash
LLM_TIMEOUT=300
LLM_RETRIES=3
VISION_MODEL=google/gemini-3.7-flash
VISION_MAX_TOKENS=4000
TASK_REPHRASE_FILE_MAX_CHARS=5000
EMBEDDING_API_KEY=replace-with-your-key
EMBEDDING_API_URL=https://your-provider.example/v1/embeddings
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TIMEOUT=120

KNOWLEDGE_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_COLLECTION_PREFIX=project
QDRANT_SCORE_THRESHOLD=0.35
KNOWLEDGE_INDEX_POLL_SECONDS=2
KNOWLEDGE_INDEX_MAX_ATTEMPTS=5
KNOWLEDGE_JOB_RETENTION_DAYS=30
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_CHUNK_TARGET_CHARS=2200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=300
KNOWLEDGE_AGENT_SEMANTIC_LIMIT=10
KNOWLEDGE_VISION_ENABLED=true

# Постоянный проектный чат. Конкурентность указана на процесс backend.
AGENT_CONCURRENCY=2
AGENT_POLL_SECONDS=1
# Общий срок одной попытки: память, поиск, планирование и итоговый ответ.
AGENT_TURN_TIMEOUT_SECONDS=600
AGENT_HISTORY_MESSAGES=10
AGENT_SUMMARY_BATCH_SIZE=10
# Раунды инструментов перед итоговым ответом; до 8 вызовов за раунд.
AGENT_TOOL_ROUNDS=8

# Общий чат участников проекта. В Compose URL переопределяется адресом сервиса redis.
CHAT_REDIS_URL=redis://localhost:6381/0
CHAT_REDIS_MAX_CONNECTIONS=30
CHAT_REDIS_TIMEOUT=3
CHAT_QUEUE_SIZE=128
CHAT_MAX_CONNECTIONS=2000
CHAT_SOCKET_SEND_TIMEOUT=5
CHAT_HEARTBEAT_SECONDS=20
CHAT_PRESENCE_TTL_SECONDS=60
CHAT_TYPING_TTL_SECONDS=5
CHAT_EPHEMERAL_SWEEP_SECONDS=2
CHAT_OUTBOX_POLL_SECONDS=0.25
CHAT_OUTBOX_BATCH_SIZE=100
CHAT_SEND_PER_MINUTE=30
CHAT_ACTIONS_PER_MINUTE=120
CHAT_DRAFT_RETENTION_HOURS=24
CHAT_CLEANUP_SECONDS=3600
CHAT_MAX_FRAME_BYTES=65536
