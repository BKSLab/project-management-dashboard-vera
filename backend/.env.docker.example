# Используется docker-compose для backend-контейнера (env_file: ./backend/.env.docker).
# POSTGRES_USER/PASSWORD/NAME должны совпадать со значениями в корневом .env
# (там же ключи называются POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_NAME=project_management_dashboard_vera

# HTTP-приложение
APP_NAME=Project Management Dashboard Vera
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOGGING_CONFIG_PATH=/app/logging.ini
